#!/usr/bin/env python3
"""selly-agent launcher — the single CLI front door.

Two jobs, in order. First, make sure we are running on the interpreter that holds this
install's dependencies: a version directory carries its own .venv, and whatever python3 the
shebang found is almost certainly not inside it, so re-exec onto it. Then resolve the package
under src/ onto sys.path (following the current -> versions/<v> symlink so code always loads
from the installed version) and dispatch argv to the package CLI.

Kept dependency-free, because it runs before the venv that holds the dependencies: launchd's
ProgramArguments point straight at this file, and the ~/.local/bin shim is a symlink to it.
"""

from __future__ import annotations

import os
import sys


def venv_interpreter(tree):
    """The interpreter inside a tree's venv, by virtual-environment layout."""
    if os.name == "nt":
        return os.path.join(tree, ".venv", "Scripts", "python.exe")
    return os.path.join(tree, ".venv", "bin", "python")


def reexec_target(tree, prefix=None):
    """The interpreter to re-exec onto, or None to carry on with this one.

    Membership is decided by sys.prefix, not by comparing interpreter paths: a venv's python is
    a symlink into uv's shared interpreter store, so comparing resolved paths would also report
    a match when running that store interpreter *without* the venv — which is exactly the case
    that has no dependencies, and so the one case this must correct.

    None also covers a checkout nobody has bootstrapped yet, so dependency-free commands still
    work there rather than the launcher dying before it can say what to do about it.
    """
    interpreter = venv_interpreter(tree)
    if not os.path.exists(interpreter):
        return None
    current = os.path.realpath(prefix if prefix is not None else sys.prefix)
    if current == os.path.realpath(os.path.join(tree, ".venv")):
        return None
    return interpreter


_here = os.path.dirname(os.path.realpath(__file__))
_tree = os.path.dirname(_here)

_target = reexec_target(_tree)
if _target is not None:
    os.execv(_target, [_target, os.path.realpath(__file__), *sys.argv[1:]])

_src = os.path.join(_tree, "src")
if _src not in sys.path:
    sys.path.insert(0, _src)

from selly_agent.cli import main  # noqa: E402 — sys.path must be set first

if __name__ == "__main__":
    sys.exit(main(sys.argv))
