#!/usr/bin/env python3
"""selly-agent launcher — the single CLI front door.

Two jobs, in order: re-exec onto the interpreter holding this install's dependencies (a version
directory carries its own .venv, and whatever python3 the shebang found is not inside it), then
resolve the package under src/ onto sys.path — following the current -> versions/<v> symlink, so
code always loads from the installed version — and dispatch argv to the package CLI.

Stays dependency-free, since it runs before the venv that holds the dependencies. launchd's
ProgramArguments point straight at this file, and the ~/.local/bin shim is a symlink to it.
"""

from __future__ import annotations

import os
import sys


def venv_interpreter(tree):
    """The interpreter inside a tree's venv, by virtual-environment layout."""
    if os.name == "nt":
        return os.path.join(tree, ".venv", "Scripts", "python.exe")
    return os.path.join(tree, ".venv", "bin", "python")


def _die(message):
    if sys.stderr is not None:  # a windowless interpreter has none
        sys.stderr.write(f"selly-agent: {message}\n")
    raise SystemExit(2)


def apply_env_file(argv, environ):
    """Apply and strip a --env-file argument — the supervised job's pinned environment.

    The scheduled task that starts the daemon on Windows cannot carry environment variables in
    its definition, so the supervisor records them in a companion file and names it in the job's
    arguments. Applied here, before the re-exec (the venv child inherits it) and before anything
    resolves a path. A named file that cannot be read is a broken install, and the daemon must
    not come up resolving a different world's paths — so that fails rather than proceeds.
    """
    if "--env-file" not in argv:
        return argv
    index = argv.index("--env-file")
    if index + 1 >= len(argv):
        _die("--env-file needs a path")
    import json

    try:
        with open(argv[index + 1], encoding="utf-8") as fh:
            environment = json.load(fh)
    except (OSError, ValueError) as exc:
        _die(f"could not read the recorded job environment at {argv[index + 1]}: {exc}")
    environ.update({str(key): str(value) for key, value in environment.items()})
    return argv[:index] + argv[index + 2 :]


def reexec_target(tree, prefix=None):
    """The interpreter to re-exec onto, or None to carry on with this one.

    Membership is decided by sys.prefix, not by comparing interpreter paths: a venv's python is a
    symlink into uv's shared interpreter store, so comparing resolved paths would also match the
    store interpreter running *without* the venv — the one case that has no dependencies, and so
    the one this exists to correct. Being the prefix, the same check is the exec-loop guard.

    None also covers a checkout nobody has bootstrapped, so dependency-free commands still work.
    """
    interpreter = venv_interpreter(tree)
    if not os.path.exists(interpreter):
        return None
    current = os.path.realpath(prefix if prefix is not None else sys.prefix)
    if current == os.path.realpath(os.path.join(tree, ".venv")):
        return None
    return interpreter


_here = os.path.dirname(os.path.realpath(__file__))
_tree = os.path.dirname(_here)

sys.argv = apply_env_file(sys.argv, os.environ)
_target = reexec_target(_tree)
if _target is not None:
    _argv = [_target, os.path.realpath(__file__), *sys.argv[1:]]
    if os.name == "nt":
        # Windows has no exec that replaces the caller: it would start the real process and let
        # this one return, so the command would appear to finish while the work was elsewhere.
        # Ctrl+C belongs to the child while this parent waits — run() would otherwise answer the
        # interrupt by killing the child it handed the terminal to.
        import signal
        import subprocess

        signal.signal(signal.SIGINT, signal.SIG_IGN)
        raise SystemExit(subprocess.run(_argv).returncode)
    os.execv(_target, _argv)

_src = os.path.join(_tree, "src")
if _src not in sys.path:
    sys.path.insert(0, _src)

from selly_agent.cli import main  # noqa: E402 — sys.path must be set first


def dispatch(argv):
    """Run the CLI, turning a missing dependency into the instruction that fixes it.

    Subcommands import lazily, so a tree whose venv was never built fails several frames into a
    command with a traceback naming psutil — and nothing naming setup. Our own modules are
    re-raised, since a missing one of those is a broken install rather than an unbuilt one.
    """
    try:
        return main(argv)
    except ModuleNotFoundError as exc:
        if (exc.name or "").startswith("selly_agent"):
            raise
        door = "setup.ps1" if os.name == "nt" else "setup"
        if sys.stderr is not None:  # a windowless interpreter has none, as _die knows
            sys.stderr.write(
                f"selly-agent: cannot import {exc.name} — this install's dependencies are not "
                f"in place yet.\nRun {os.path.join(_tree, door)} to build them, or "
                f"`make bootstrap` in a checkout.\n"
            )
        return 1


if __name__ == "__main__":
    sys.exit(dispatch(sys.argv))
