#!/bin/sh
# The installer's front door — and deliberately almost nothing.
#
# It does the one job Python cannot do for itself: establish the interpreter to hand over to.
# Not the machine's python3, which may not exist and whose version and cert store are not ours
# to rely on — uv provisions a standalone one at the version .python-version pins, then installs
# this release's dependencies from uv.lock. Every decision, prompt and write after that lives in
# the Python installer, shared with `selly-agent update`.
#
# installer/runtime.py fetches uv the same way for updates. Both read the pin file, so the
# version and digests are not duplicated even though this logic is.
#
# POSIX sh, no bashisms: it runs on whatever /bin/sh the machine has, before anything exists.

set -eu

here=$(cd "$(dirname "$0")" && pwd)
pin="$here/src/selly_agent/data/uv-pin.txt"

# --bootstrap-only stops once the runtime is ready, without installing anything on the machine;
# --with-dev also installs the dev dependency group. Together they let `make bootstrap` reuse
# this fetch. Both are stripped from what the installer receives.
bootstrap_only=0
with_dev=0
for arg in "$@"; do
	case "$arg" in
	--bootstrap-only) bootstrap_only=1 ;;
	--with-dev) with_dev=1 ;;
	esac
done
if [ "$bootstrap_only" -eq 1 ] || [ "$with_dev" -eq 1 ]; then
	forwarded=""
	for arg in "$@"; do
		case "$arg" in
		--bootstrap-only | --with-dev) ;;
		*) forwarded="$forwarded $arg" ;;
		esac
	done
	# Word-splitting is the point here: rebuild the argument list without our own flags.
	# shellcheck disable=SC2086
	set -- $forwarded
fi

say() {
	echo "$1"
}

die() {
	echo "$1" >&2
	exit 1
}

[ -f "$pin" ] || die "this tree is missing $pin; re-download the release."

uv_version=$(awk '$1 == "version" { print $2 }' "$pin")
[ -n "$uv_version" ] || die "$pin names no uv version."

# uv's release archives are named by Rust target triple. Kept in step with the table in
# selly_agent/installer/runtime.py.
case "$(uname -s)/$(uname -m)" in
Darwin/arm64 | Darwin/aarch64) triple="aarch64-apple-darwin" ;;
Darwin/x86_64) triple="x86_64-apple-darwin" ;;
Linux/aarch64 | Linux/arm64) triple="aarch64-unknown-linux-gnu" ;;
Linux/x86_64) triple="x86_64-unknown-linux-gnu" ;;
*) die "no pinned uv build for $(uname -s)/$(uname -m)." ;;
esac

expected=$(awk -v t="$triple" '$1 == "sha256" && $2 == t { print $3 }' "$pin")
[ -n "$expected" ] || die "$pin records no digest for $triple; refusing to run an unverified binary."

# Deliberately not ~/.local/bin: the user may have their own uv there, and a second thing on
# PATH that nothing owns is not something an uninstall could clean up. Mirrors paths.uv_path().
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
tools="$data_home/selly-agent/tools"
uv="$tools/uv"

# Whether a uv can offer a *final* build of the interpreter we pin — asked, not inferred from
# uv's own version. uv refreshes its list of downloadable interpreters over the network, so an
# old uv usually knows about new releases; one that cannot reach that list falls back to what was
# baked in when it was built, which for an old enough uv is a pre-release. A final release reads
# `cpython-3.14.6-<platform>` and a pre-release puts a marker before the dash, so requiring
# digits-then-dash tells them apart.
serves_pin() {
	[ -x "$1" ] || return 1
	"$1" python list 2>/dev/null | grep -qE "^cpython-$(echo "$pinned" | sed 's/\./\\./g')(\.[0-9]+)*-"
}

# `read` rather than cat|tr: this runs before anything is installed, so every external tool it
# needs is one more thing that can be missing. It also strips the trailing newline for us.
read -r pinned <"$here/.python-version" 2>/dev/null || pinned=""
[ -n "$pinned" ] || die "this tree is missing .python-version; re-download the release."

if serves_pin "$(command -v uv 2>/dev/null || echo /nonexistent)"; then
	uv="$(command -v uv)"
	say "using the uv already on your PATH ($("$uv" --version))"
elif serves_pin "$uv"; then
	say "using the uv from a previous install ($("$uv" --version))"
else
	command -v curl >/dev/null 2>&1 || die "curl is required and isn't on your PATH."
	command -v shasum >/dev/null 2>&1 || command -v sha256sum >/dev/null 2>&1 ||
		die "shasum or sha256sum is required and isn't on your PATH."

	say "Fetching uv $uv_version — it provisions the Python this runs on."
	work="$(mktemp -d)"
	trap 'rm -rf "$work"' EXIT INT TERM
	asset="uv-$triple.tar.gz"
	url="https://github.com/astral-sh/uv/releases/download/$uv_version/$asset"
	curl -fsSL "$url" -o "$work/$asset" || die "couldn't download $url"

	if command -v shasum >/dev/null 2>&1; then
		actual=$(shasum -a 256 "$work/$asset" | awk '{ print $1 }')
	else
		actual=$(sha256sum "$work/$asset" | awk '{ print $1 }')
	fi
	[ "$actual" = "$expected" ] ||
		die "$asset does not match the digest recorded for uv $uv_version — refusing it."

	# The archive holds uv-<triple>/{uv,uvx}: strip that level and take uv by name, which needs
	# no extra tools and cannot pick the wrong file.
	tar -xzf "$work/$asset" -C "$work" --strip-components=1 || die "couldn't unpack $asset."
	[ -f "$work/uv" ] || die "the uv archive doesn't contain a uv binary."
	mkdir -p "$tools"
	# Move into place, so a half-extracted binary is never runnable at the final name.
	chmod 755 "$work/uv" && mv "$work/uv" "$uv.tmp" && mv "$uv.tmp" "$uv"
	say "uv $uv_version installed at $uv"
fi

say "Preparing the Python runtime and dependencies…"
"$uv" python install --project "$here" >/dev/null ||
	die "uv couldn't install the Python version this release pins."

if [ "$with_dev" -eq 1 ]; then
	"$uv" sync --locked --project "$here" || die "uv couldn't install the dependencies."
else
	"$uv" sync --locked --no-dev --project "$here" >/dev/null ||
		die "uv couldn't install this release's dependencies."
fi

python="$here/.venv/bin/python"
[ -x "$python" ] || die "the dependency install left no interpreter at $python."

if [ "$bootstrap_only" -eq 1 ]; then
	say "runtime ready: $("$python" -V)"
	exit 0
fi

exec "$python" "$here/bin/selly-agent" setup "$@"
