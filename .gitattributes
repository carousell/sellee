# Shell scripts must keep LF wherever they are checked out: cloned on Windows with
# core.autocrlf=true, a CRLF entrypoint fails inside the image as `/bin/sh^M: bad
# interpreter`, which names nothing a reader can act on.
*.sh text eol=lf
setup text eol=lf
bin/sellee text eol=lf
Dockerfile text eol=lf

# Redacted Craigslist mail and pages the tests read; folded away in GitHub's diff view.
tests/fixtures/craigslist/*.eml linguist-generated=true
tests/fixtures/craigslist/*.html linguist-generated=true
